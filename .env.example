# Stripe (Dashboard → Developers → API keys). Use sk_test_… for testing, sk_live_… in production.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint pointing at /api/stripe/webhook (Dashboard → Developers → Webhooks).
STRIPE_WEBHOOK_SECRET=
# Set to "true" once Stripe Tax is configured (Dashboard → Tax) to calculate sales tax / VAT at checkout.
STRIPE_AUTOMATIC_TAX=false
